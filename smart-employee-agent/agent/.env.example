# Core HR agent (Patterns 1-3)
ASGARDEO_BASE_URL=https://api.asgardeo.io/t/<tenant>
ASGARDEO_CLIENT_ID=<mcp-client-app-client-id>
AGENT_ID=<agent-id>
AGENT_SECRET=<agent-secret>
# The inbound caller is the SPA; this differs from it-agent/TOKEN_AUDIENCE.
TOKEN_AUDIENCE=<spa-app-client-id>
JWKS_URL=https://api.asgardeo.io/t/<tenant>/oauth2/jwks
AUTH_ISSUER=https://api.asgardeo.io/t/<tenant>/oauth2/token
OBO_REDIRECT_URI=http://localhost:5001/api/obo/callback

# Create this API key in Google AI Studio, separately from Google OAuth.
GOOGLE_API_KEY=<google-ai-studio-key>
MODEL_NAME=gemini-2.5-flash
HR_MCP_SERVER_URL=http://127.0.0.1:8000/mcp

# Pattern 4: HR agent delegates IT questions to a separate agent identity.
IT_AGENT_ENABLED=false
IT_AGENT_URL=http://127.0.0.1:5002
IT_AGENT_TIMEOUT=60
# Optional user-authority token exchange; must match it-agent/.env.
A2A_DELEGATION=false

# Patterns 5-6: HR approval -> employee CIBA consent -> Google Calendar.
# Use a separate confidential application with CIBA, JWT access tokens,
# Organization role audience and hr_self_mcp authorization. Configure its
# Google-only login step and mandatory adaptive script from the README.
CIBA_ENABLED=false
CIBA_CLIENT_ID=
CIBA_CLIENT_SECRET=
CIBA_NOTIFY_SCOPES=openid profile email hr_self_mcp
CIBA_NOTIFY_TIMEOUT_SECONDS=300
# Try the user's subject only if no username/email claim was captured.
CIBA_HINT_FALLBACK_SUB=true
# Set one random value here and in hr-server/.env. Do not duplicate this key.
AGENT_WEBHOOK_SECRET=

# Google access comes only from Asgardeo's federated_tokens response.
# The value must match the Google connection's name exactly.
GOOGLE_CALENDAR_ENABLED=false
FEDERATED_IDP_NAME=
FEDERATED_TOKEN_SCOPE=https://www.googleapis.com/auth/calendar.events

# Optional OBO consent-screen demonstration. The mandatory Calendar login
# script forces authentication independently of this consent-only setting.
OBO_PROMPT_CONSENT=false

DISABLE_SSL_VERIFY=false
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ACCESS_LOG=false
# Decoded Asgardeo token claims, with credentials omitted.
DEBUG_TOKENS=false
# Full Google federated-token output only. Contains live credentials.
DEBUG_FEDERATED_TOKENS_RAW=false
# All raw JWTs, including Asgardeo tokens. Contains live credentials.
DEBUG_TOKENS_RAW=false
