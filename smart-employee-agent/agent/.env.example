# Agent Server Configuration

# Asgardeo base URL (tenant URL)
ASGARDEO_BASE_URL=https://api.asgardeo.io/t/<tenant>

# MCP Client Application's Client ID
ASGARDEO_CLIENT_ID=<mcp-client-app-client-id>

# Agent credentials (from Asgardeo Console > Agents)
AGENT_ID=<agent-id>
AGENT_SECRET=<agent-secret>

# SPA Application's Client ID (used as JWT audience)
TOKEN_AUDIENCE=<spa-app-client-id>

# JWT validation
JWKS_URL=https://api.asgardeo.io/t/<tenant>/oauth2/jwks
AUTH_ISSUER=https://api.asgardeo.io/t/<tenant>/oauth2/token

# OBO callback URI (must match Asgardeo app redirect URI)
OBO_REDIRECT_URI=http://localhost:5001/api/obo/callback

# LLM configuration
GOOGLE_API_KEY=<google-ai-studio-key>
MODEL_NAME=gemini-2.5-flash

# HR MCP Server URL
HR_MCP_SERVER_URL=http://127.0.0.1:8000/mcp

# ─── Pattern 4: IT Agent delegation (optional) ──────────────────────────────
# Set to "true" to give this agent the `ask_it_agent` tool. Requires the IT
# Agent + IT MCP server running, and the 'it_agent_invoke' scope on this
# agent's role in Asgardeo.
IT_AGENT_ENABLED=false
IT_AGENT_URL=http://127.0.0.1:5002
IT_AGENT_TIMEOUT=60

# ─── Pattern 5: CIBA out-of-band approval (optional) ────────────────────────
# Lets the agent get an HR Admin's approval when that admin is NOT in the
# session and has no browser here. They approve on their own device.
#
# Requires in Asgardeo:
#   - CIBA added to the app's Allowed grant types
#   - a CLIENT SECRET on the MCP Client Application (CIBA needs client auth;
#     the App Native Auth flow does not, which is why there is none today)
#   - a notification channel configured (Email, SMS, or External)
CIBA_ENABLED=false
# Separate CONFIDENTIAL app (the App Native Auth app is public and has no
# secret, so CIBA cannot use it).
CIBA_CLIENT_ID=<agent-approval-client-id>
CIBA_CLIENT_SECRET=<agent-approval-client-secret>
# login_hint — the HR Admin who approves (username or email as Asgardeo expects)
CIBA_APPROVER=<hr-admin-username-or-email>
CIBA_SCOPES=openid hr_approve_mcp
CIBA_TIMEOUT_SECONDS=90

# ─── Pattern 6: Google Calendar sync (optional) ─────────────────────────────
# When a leave is approved, the agent adds it to the EMPLOYEE's own Google
# Calendar using a SEPARATE consent the employee grants to Google. Asgardeo has
# no authority here — this is a second, independent delegation.
#
# Requires a Google Cloud project (Google Auth Platform, not the old
# "OAuth consent screen" page):
#   1. APIs & Services > Library > enable "Google Calendar API"
#   2. Google Auth Platform > Get started > set Audience to External
#      (Internal is not offered on personal @gmail.com accounts)
#   3. Data Access > add scope .../auth/calendar.events
#   4. Audience > Test users > add each demo employee's Google account
#   5. Clients > Create client > Web application, redirect URI below
GOOGLE_CALENDAR_ENABLED=false
GOOGLE_CLIENT_ID=<google-oauth-client-id>
GOOGLE_CLIENT_SECRET=<google-oauth-client-secret>
GOOGLE_REDIRECT_URI=http://localhost:5001/api/google/callback

# Set to "true" to disable SSL verification (dev only)
DISABLE_SSL_VERIFY=true

# ─── Token inspection (development only) ────────────────────────────────────
# Pretty-prints the DECODED claims of each token to the log, so a delegation
# chain (sub = the person, act.sub = the agent) can be shown on screen without
# pasting a JWT into a third-party decoder. Never prints the token itself.
# Leave false outside a demo.
DEBUG_TOKENS=false

# ALSO print the encoded token, on its own line, for pasting into jwt.io.
# This writes a live bearer token to the log — anyone who reads that log, or a
# screenshot of it, can replay the token until it expires. Throwaway tenants
# only, and turn it off afterwards. Implies DEBUG_TOKENS.
DEBUG_TOKENS_RAW=false

# uvicorn's per-request access line ("GET /api/leaves 200 OK"). Off by default
# so the token/authorization lines stay readable on screen; set true to trace
# raw HTTP traffic.
ACCESS_LOG=false

# ─── Pattern 4+: carry the USER's authority on the IT hop ───────────────────
# When true, the agent requires the user's consent before delegating to the IT
# Agent, and forwards their delegated token so the far side can exchange it for
# one naming both agents. Must match A2A_DELEGATION in it-agent/.env.
A2A_DELEGATION=false

# ─── Offline approval notice (employee not in a browser) ────────────────────
# The HR server calls the agent when a leave is approved; the agent then
# reaches the employee on their own device with CIBA — the binding message is
# the notification AND the request for consent. Must match hr-server/.env.
AGENT_WEBHOOK_SECRET=<a-long-random-shared-secret>
# Scopes asked for on the employee's out-of-band approval.
CIBA_NOTIFY_SCOPES=openid hr_self_mcp
CIBA_NOTIFY_TIMEOUT_SECONDS=300
# If no token ever carried the employee's email/username, try their subject as
# the CIBA login_hint instead of giving up. The proper fix is to add 'email' to
# the application's requested attributes and access token attributes.
CIBA_HINT_FALLBACK_SUB=true
# Where the emailed link points. Must be reachable from the recipient's phone,
# so localhost only works if they open it on this machine.
PUBLIC_BASE_URL=http://localhost:5001
# Email a receipt when the calendar sync already succeeded. Off by default:
# the CIBA prompt already notified them and the entry is in their calendar, so
# a mail that asks nothing is just noise. The link email is always sent when
# Google is NOT yet connected, because that one needs action.
SEND_SYNC_RECEIPT=false
# Signs the one-time links. Set it, or links stop working on every restart.
ACTION_LINK_SECRET=<a-long-random-secret>
ACTION_LINK_TTL_SECONDS=604800

# ─── Email ──────────────────────────────────────────────────────────────────
# Google has no out-of-band consent, so an employee who has not connected
# Calendar gets a link they must open in a browser. Leave SMTP_HOST empty and
# the message is printed to the log instead — enough to demo the whole flow.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Corporate Concierge <no-reply@example.com>
SMTP_STARTTLS=true

# Asgardeo only shows the consent screen the first time a user grants a given
# set of scopes to an application; after that the popup redirects straight
# through. Set true to force it every time — useful when the consent screen is
# the thing being demonstrated.
OBO_PROMPT_CONSENT=false

# ─── Federated token sharing (Asgardeo brokers Google) ──────────────────────
# When set, the OBO authorize call asks Asgardeo to pass through the token its
# upstream connection issued, so the agent needs no Google OAuth client of its
# own: signing in to Google at Asgardeo yields calendar access in one consent.
#
# Requires a standard OIDC connection with ShareFederatedToken=true on its
# authenticator (set via the Identity Provider Management API), and the
# connection added as a sign-in option on this application. The name must
# match the connection's name in Asgardeo EXACTLY — it keys the scope set.
# Leave empty to keep using the agent's own Google OAuth client.
FEDERATED_IDP_NAME=
FEDERATED_TOKEN_SCOPE=https://www.googleapis.com/auth/calendar.events
