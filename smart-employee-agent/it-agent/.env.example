# IT Agent Server
#   Pattern 4 — another agent calls it (/api/ask, /api/tickets)
#   Pattern 7 — a person calls it directly (/api/desk/*)

# Asgardeo base URL (tenant URL)
ASGARDEO_BASE_URL=https://api.asgardeo.io/t/<tenant>

# MCP Client Application's Client ID (same app the HR agent uses)
ASGARDEO_CLIENT_ID=<mcp-client-app-client-id>

# IT Agent credentials (from Asgardeo Console > Agents) — a DIFFERENT agent
# identity from the HR agent.
IT_AGENT_ID=<it-agent-id>
IT_AGENT_SECRET=<it-agent-secret>

# Where Asgardeo returns the user after they consent on the service-desk path.
# This is now a REAL redirect (Pattern 7 opens a consent popup), so it must be
# this agent's own callback AND registered on the MCP Client Application.
# An unregistered value fails with "invalid_callback - callback.not.match".
IT_REDIRECT_URI=http://localhost:5002/api/desk/obo/callback

# JWT validation. Two kinds of token arrive here with DIFFERENT audiences:
#   - agent tokens (Pattern 4) are minted for the MCP Client app
#   - user tokens (Pattern 7) are minted for the SPA
# Both are accepted, then told apart by the `aut` claim.
JWKS_URL=https://api.asgardeo.io/t/<tenant>/oauth2/jwks
AUTH_ISSUER=https://api.asgardeo.io/t/<tenant>/oauth2/token
TOKEN_AUDIENCE=<mcp-client-app-client-id>
SPA_CLIENT_ID=<spa-app-client-id>

# Scope a calling AGENT must hold to invoke this agent
IT_INVOKE_SCOPE=it_agent_invoke

# Scope a PERSON must hold to use the service desk directly. Grant it to the
# service-desk role, including the role mapped to federated partner-org users.
IT_DESK_SCOPE=it_desk_access

# Origins allowed to call the desk from a browser, and the postMessage targets
# for the consent popup. The desk is reached directly by the SPA, so this
# process needs its own CORS allowlist.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# LLM configuration
GOOGLE_API_KEY=<google-ai-studio-key>
MODEL_NAME=gemini-2.5-flash

# IT MCP Server URL
IT_MCP_SERVER_URL=http://127.0.0.1:8001/mcp

IT_AGENT_PORT=5002

# Set to "true" to disable SSL verification (dev only)
DISABLE_SSL_VERIFY=false

# ─── Token inspection (development only) ────────────────────────────────────
# Pretty-prints the DECODED claims of each token to the log, so a delegation
# chain (sub = the person, act.sub = the agent) can be shown on screen without
# pasting a JWT into a third-party decoder. Never prints the token itself.
# Leave false outside a demo.
DEBUG_TOKENS=false

# ALSO print the encoded token, on its own line, for pasting into jwt.io.
# This writes a live bearer token to the log — anyone who reads that log, or a
# screenshot of it, can replay the token until it expires. Throwaway tenants
# only, and turn it off afterwards. Implies DEBUG_TOKENS.
DEBUG_TOKENS_RAW=false

# uvicorn's per-request access line ("GET /api/leaves 200 OK"). Off by default
# so the token/authorization lines stay readable on screen; set true to trace
# raw HTTP traffic.
ACCESS_LOG=false

# ─── Pattern 4+: carry the USER's authority across the A2A hop ──────────────
# When true, the HR Agent forwards the user's delegated token and this agent
# exchanges it (RFC 8693) for one whose actor chain names BOTH agents:
#   sub = the user, act = this agent, act.act = the calling agent
# The IT resource server then authorizes the PERSON, not the agent, while the
# audit trail still records every agent that carried the request.
#
# Requires token exchange enabled on the application. It is usually a
# confidential-client grant, so this normally needs a separate app with a
# secret (the App Native Auth app is public).
A2A_DELEGATION=false
# Refuse the request rather than silently acting on the agent's own, broader
# authority when the exchange fails.
A2A_REQUIRE_DELEGATION=false
EXCHANGE_CLIENT_ID=<confidential-app-client-id>
EXCHANGE_CLIENT_SECRET=<confidential-app-client-secret>
