# HR MCP Server Configuration

# Asgardeo OAuth2 issuer URL (token endpoint)
AUTH_ISSUER=https://api.asgardeo.io/t/<tenant>/oauth2/token

# MCP Client Application's Client ID (audience for MCP tokens)
CLIENT_ID=<mcp-client-app-client-id>

# SPA Application's Client ID (audience for browser REST tokens)
SPA_CLIENT_ID=<spa-app-client-id>

# JWKS endpoint for JWT signature verification
JWKS_URL=https://api.asgardeo.io/t/<tenant>/oauth2/jwks

# Set to "true" to disable SSL verification (dev only)
DISABLE_SSL_VERIFY=false

# Optional: client_id of the confidential employee-Calendar consent app (Pattern 5).
# Tokens minted by that app carry it as `aud`, so the MCP endpoint must accept
# it in addition to CLIENT_ID.
CIBA_CLIENT_ID=

# ─── Token inspection (development only) ────────────────────────────────────
# Pretty-prints the DECODED claims of each token to the log, so a delegation
# chain (sub = the person, act.sub = the agent) can be shown on screen without
# pasting a JWT into a third-party decoder. Never prints the token itself.
# Leave false outside a demo.
DEBUG_TOKENS=false

# ALSO print the encoded token, on its own line, for pasting into jwt.io.
# This writes a live bearer token to the log — anyone who reads that log, or a
# screenshot of it, can replay the token until it expires. Throwaway tenants
# only, and turn it off afterwards. Implies DEBUG_TOKENS.
DEBUG_TOKENS_RAW=false

# uvicorn's per-request access line ("GET /api/leaves 200 OK"). Off by default
# so the token/authorization lines stay readable on screen; set true to trace
# raw HTTP traffic.
ACCESS_LOG=false

# ─── Tell the agent when a leave is approved ────────────────────────────────
# The employee may be nowhere near a browser, so nothing on their side can
# notice. This server is the only party that knows the moment it happens.
# Configure the same random secret as agent/.env when CIBA is enabled.
# Fire-and-forget: a notification failure never fails the approval.
AGENT_WEBHOOK_URL=http://localhost:5001/api/events/leave-approved
AGENT_WEBHOOK_SECRET=
AGENT_WEBHOOK_TIMEOUT=10
